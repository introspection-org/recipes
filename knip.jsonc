{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The documents tests build the adapters' Python environments with uv, and
  // render a converted Word file with LibreOffice when it is installed.
  "ignoreBinaries": ["uv", "soffice"],
  "ignoreIssues": {
    // A companion exports its module by name and as the default export the
    // host's loader imports.
    "packages/*/*/src/index.ts": ["duplicates"],
    "packages/search/src/index.ts": ["duplicates"],
    "packages/issues/src/index.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs!",
        "packages/mcp-client/npm/*.mjs!",
        // Bundled or spawned on their own: scripts/build-mcp-daemon.mjs and
        // src/mcp/index.ts (compiledEntrypoint).
        "src/mcp/daemon/index.ts!",
        "src/mcp/cli/run-worker.ts!",
        "src/mcp/client-entry.ts!",
        // The `tools` command's shim runs it by path (src/tools/shell.ts).
        "src/tools/entry.ts!",
        "test/**/*.test.ts",
        // Imported by path from the provider package a fixture writes.
        "test/helpers/in-memory-google.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "scripts/*.mjs!",
        "packages/mcp-client/npm/*.mjs!",
        "test/**/*.ts"
      ],
      // Loaded from the Recipe's install first, then from Pi's own copy
      // (src/recipe/extensions.ts::loadJiti), so the host never pins it.
      "ignoreDependencies": ["jiti"]
    },
    "packages/*/*": {
      "project": ["src/**/*.ts!"]
    },
    "packages/search": {
      "project": ["src/**/*.ts!"]
    },
    "packages/issues": {
      "project": ["src/**/*.ts!"]
    },
    // Its integration tests run against the Google emulator and fake MCP
    // servers, which are its own devDependencies.
    "packages/productivity/google": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "examples": {
      // The docs snippets: extensions and evals a Recipe loads by path, and
      // the fakes its evals bind.
      "entry": [
        "**/extensions/*.ts",
        "**/*.eval.ts",
        "**/fakes/**/*.ts",
        "test/**/*.test.ts"
      ],
      "project": ["**/*.ts"]
    }
  }
}
