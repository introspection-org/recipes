{
  "servers": [
    {
      "url": "https://example-server.modelcontextprotocol.io/debug/mcp",
      "serverInfo": {
        "name": "Debug MCP App Server",
        "version": "1.0.0"
      },
      "tools": [
        {
          "name": "debug-tool",
          "title": "Debug Tool",
          "description": "Comprehensive debug tool for testing MCP Apps SDK. Configure content types, error simulation, delays, and more.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "contentType": {
                "default": "text",
                "type": "string",
                "enum": [
                  "text",
                  "image",
                  "audio",
                  "resource",
                  "resourceLink",
                  "mixed"
                ]
              },
              "multipleBlocks": {
                "default": true,
                "type": "boolean"
              },
              "includeStructuredContent": {
                "default": true,
                "type": "boolean"
              },
              "includeMeta": {
                "default": true,
                "type": "boolean"
              },
              "largeInput": {
                "type": "string"
              },
              "simulateError": {
                "default": false,
                "type": "boolean"
              },
              "delayMs": {
                "type": "number"
              }
            }
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://debug-tool/mcp-app.html"
            },
            "ui/resourceUri": "ui://debug-tool/mcp-app.html"
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "timestamp": {
                "type": "string"
              },
              "counter": {
                "type": "number"
              },
              "largeInputLength": {
                "type": "number"
              }
            },
            "required": [
              "config",
              "timestamp",
              "counter"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "debug-refresh",
          "title": "Refresh Debug Info",
          "description": "App-only tool for polling server state. Not visible to the model.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {}
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://debug-tool/mcp-app.html",
              "visibility": [
                "app"
              ]
            },
            "ui/resourceUri": "ui://debug-tool/mcp-app.html"
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "counter": {
                "type": "number"
              }
            },
            "required": [
              "timestamp",
              "counter"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "debug-log",
          "title": "Log to File",
          "description": "App-only tool for logging events to the server log file. Not visible to the model.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "type": {
                "type": "string"
              },
              "payload": {}
            },
            "required": [
              "type",
              "payload"
            ]
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://debug-tool/mcp-app.html",
              "visibility": [
                "app"
              ]
            },
            "ui/resourceUri": "ui://debug-tool/mcp-app.html"
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "logged": {
                "type": "boolean"
              },
              "logFile": {
                "type": "string"
              }
            },
            "required": [
              "logged",
              "logFile"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "url": "https://example-server.modelcontextprotocol.io/map/mcp",
      "serverInfo": {
        "name": "CesiumJS Map Server",
        "version": "1.0.0"
      },
      "tools": [
        {
          "name": "show-map",
          "title": "Show Map",
          "description": "Display an interactive world map zoomed to a specific bounding box. Use the GeoCode tool to find the bounding box of a location. The widget is interactive and exposes tools for navigation (fly to locations) and querying the current view.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "west": {
                "default": -0.5,
                "description": "Western longitude (-180 to 180)",
                "type": "number"
              },
              "south": {
                "default": 51.3,
                "description": "Southern latitude (-90 to 90)",
                "type": "number"
              },
              "east": {
                "default": 0.3,
                "description": "Eastern longitude (-180 to 180)",
                "type": "number"
              },
              "north": {
                "default": 51.7,
                "description": "Northern latitude (-90 to 90)",
                "type": "number"
              },
              "label": {
                "description": "Optional label to display on the map",
                "type": "string"
              }
            }
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://cesium-map/mcp-app.html"
            },
            "ui/resourceUri": "ui://cesium-map/mcp-app.html"
          }
        },
        {
          "name": "geocode",
          "title": "Geocode",
          "description": "Search for places using OpenStreetMap. Returns coordinates and bounding boxes for up to 5 matches.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "query": {
                "type": "string",
                "description": "Place name or address to search for (e.g., 'Paris', 'Golden Gate Bridge', '1600 Pennsylvania Ave')"
              }
            },
            "required": [
              "query"
            ]
          }
        }
      ]
    },
    {
      "url": "https://example-server.modelcontextprotocol.io/pdf/mcp",
      "serverInfo": {
        "name": "PDF Server",
        "version": "2.0.0"
      },
      "tools": [
        {
          "name": "list_pdfs",
          "description": "List available PDFs that can be displayed",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {}
          }
        },
        {
          "name": "read_pdf_bytes",
          "title": "Read PDF Bytes",
          "description": "Read a range of bytes from a PDF (max 512KB per request). The model should NOT call this tool directly.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "url": {
                "type": "string",
                "description": "PDF URL or local file path"
              },
              "offset": {
                "default": 0,
                "description": "Byte offset",
                "type": "number",
                "minimum": 0
              },
              "byteCount": {
                "default": 524288,
                "description": "Bytes to read",
                "type": "number",
                "minimum": 1,
                "maximum": 524288
              }
            },
            "required": [
              "url"
            ]
          },
          "_meta": {
            "ui": {
              "visibility": [
                "app"
              ]
            }
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "bytes": {
                "type": "string",
                "description": "Base64 encoded bytes"
              },
              "offset": {
                "type": "number"
              },
              "byteCount": {
                "type": "number"
              },
              "totalBytes": {
                "type": "number"
              },
              "hasMore": {
                "type": "boolean"
              }
            },
            "required": [
              "url",
              "bytes",
              "offset",
              "byteCount",
              "totalBytes",
              "hasMore"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "display_pdf",
          "title": "Display PDF",
          "description": "Show and render a PDF in a read-only viewer.\n\nUse this tool when the user wants to view or read a PDF. The renderer displays the document for viewing. The widget exposes app-registered tools for page navigation, text extraction, searching, and zoom control.\n\nAccepts local files (use list_pdfs), client MCP root directories, or any HTTPS URL.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "url": {
                "default": "https://arxiv.org/pdf/1706.03762",
                "description": "PDF URL or local file path",
                "type": "string"
              },
              "page": {
                "default": 1,
                "description": "Initial page",
                "type": "number",
                "minimum": 1
              }
            }
          },
          "_meta": {
            "ui": {
              "resourceUri": "ui://pdf-viewer/mcp-app.html"
            },
            "ui/resourceUri": "ui://pdf-viewer/mcp-app.html"
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "viewUUID": {
                "type": "string",
                "description": "UUID for this viewer instance"
              },
              "url": {
                "type": "string"
              },
              "initialPage": {
                "type": "number"
              },
              "totalBytes": {
                "type": "number"
              },
              "formFieldValues": {
                "description": "Form field values filled by the user via elicitation",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                }
              },
              "formFields": {
                "description": "Form fields with bounding boxes in model coordinates (top-left origin)",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "page": {
                      "type": "number"
                    },
                    "label": {
                      "type": "string"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    },
                    "exportValue": {
                      "description": "Radio button value — pass this to fill_form",
                      "type": "string"
                    },
                    "options": {
                      "description": "Dropdown/listbox option values",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "page",
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "viewUUID",
              "url",
              "initialPage",
              "totalBytes"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "save_pdf",
          "title": "Save PDF",
          "description": "Save annotated PDF bytes back to a local file. The model should NOT call this tool directly — use interact with action: save_as instead.",
          "inputSchema": {
            "type": "object",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "url": {
                "type": "string",
                "description": "Original PDF URL or local file path"
              },
              "data": {
                "type": "string",
                "description": "Base64-encoded PDF bytes"
              }
            },
            "required": [
              "url",
              "data"
            ]
          },
          "_meta": {
            "ui": {
              "visibility": [
                "app"
              ]
            }
          },
          "outputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "filePath": {
                "type": "string"
              },
              "mtimeMs": {
                "type": "number"
              }
            },
            "required": [
              "filePath",
              "mtimeMs"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
