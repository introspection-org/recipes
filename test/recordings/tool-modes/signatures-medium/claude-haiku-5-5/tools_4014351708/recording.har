mand\\\": \\\"list\\\", \\\"from\\\": \\\"2026-11-09T00:00:00Z\\\", \\\"to\\\": \\\"2026-11-11T23:59:59Z\\\", \\\"limit\\\": 50}\"}}\n\nevent: content_block_stop\ndata: {\"type\":\"content_block_stop\",\"index\":2     }\n\nevent: message_delta\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":787,\"cache_read_input_tokens\":5930,\"output_tokens\":388,\"output_tokens_details\":{\"thinking_tokens\":175}}               }\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"       }\n\n"
