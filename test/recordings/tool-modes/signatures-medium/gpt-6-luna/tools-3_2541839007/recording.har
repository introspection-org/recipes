smoothly!\"}]},{\"type\":\"function_call\",\"id\":\"fc_00c19e1655be99b6016af1277c94dc87d0858f2963cf631371\",\"call_id\":\"call_ocgOQ9OGxILQswikJqHDHJdT\",\"name\":\"mail\",\"arguments\":\"{\\\"command\\\":\\\"draft\\\",\\\"to\\\":[\\\"dana@example.test\\\"],\\\"subject\\\":\\\"Re: Q3 budget numbers\\\",\\\"body\\\":\\\"Hi Dana,\\\\n\\\\nI’ll bring the latest budget sheet to the planning review. Here’s the link: https://docs.example.test/spreadsheets/d/f-budget\\\\n\\\\nBest,\\\\nSam\\\",\\\"reply_to\\\":\\\"msg_fdb3aecc0ff64c18\\\"}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_ocgOQ9OGxILQswikJqHDHJdT\",\"output\":\"{\\n  \\\"draft\\\": \\\"msg_ba629430ab9c47bb\\\",\\n  \\\"thread\\\": \\\"thr_21d851e725704243\\\",\\n  \\\"to\\\": [\\n    {\\n      \\\"email\\\": \\\"dana@example.test\\\"\\n    }\\n  ],\\n  \\\"subject\\\": \\\"Re: Q3 budget numbers\\\"\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"medium\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be01-f855-75da-a5e3-4a3173a3f5ed\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
