Az9lln72\",\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"tools call mail.draft --json - <<'JSON'\\\\n{\\\\\\\"reply_to\\\\\\\":\\\\\\\"msg_7a65c188cd1b4cde\\\\\\\",\\\\\\\"to\\\\\\\":[\\\\\\\"dana@example.test\\\\\\\"],\\\\\\\"subject\\\\\\\":\\\\\\\"Re: Q3 budget numbers\\\\\\\",\\\\\\\"body\\\\\\\":\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI’ll bring the Q3 budget sheet to the meeting. Here’s the link: https://docs.example.test/spreadsheets/d/f-budget\\\\\\\\n\\\\\\\\nBest,\\\\\\\\nSam\\\\\\\"}\\\\nJSON\\\",\\\"timeout\\\":30}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_otZlBmaozV7wtKQPAz9lln72\",\"output\":\"{\\n  \\\"draft\\\": \\\"msg_a4669baa4499470a\\\",\\n  \\\"thread\\\": \\\"thr_c6ff5850714a4fb7\\\",\\n  \\\"to\\\": [\\n    {\\n      \\\"email\\\": \\\"dana@example.test\\\"\\n    }\\n  ],\\n  \\\"subject\\\": \\\"Re: Q3 budget numbers\\\"\\n}\\n\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"medium\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be03-ec42-75da-a5e3-4a3e5dad8747\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
