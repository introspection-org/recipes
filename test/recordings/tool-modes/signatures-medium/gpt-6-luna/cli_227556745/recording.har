'\\\\n{\\\\\\\"reply_to\\\\\\\":\\\\\\\"msg_7a65c188cd1b4cde\\\\\\\",\\\\\\\"to\\\\\\\":[\\\\\\\"dana@example.test\\\\\\\"],\\\\\\\"subject\\\\\\\":\\\\\\\"Re: Q3 budget numbers\\\\\\\",\\\\\\\"body\\\\\\\":\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI’ll bring the Q3 budget sheet to the meeting. Here’s the link: https://docs.example.test/spreadsheets/d/f-budget\\\\\\\\n\\\\\\\\nBest,\\\\\\\\nSam\\\\\\\"}\\\\nJSON\\\",\\\"timeout\\\":30}\",\"call_id\":\"call_otZlBmaozV7wtKQPAz9lln72\",\"name\":\"bash\"}],\"parallel_tool_calls\":true,\"presence_penalty\":0.0,\"previous_response_id\":null,\"prompt_cache_key\":\"01a1be03-ec42-75da-a5e3-4a3e5dad8747\",\"prompt_cache_retention\":\"24h\",\"reasoning\":{\"context\":\"all_turns\",\"effort\":\"medium\",\"mode\":\"standard\",\"summary\":\"detailed\"},\"safety_identifier\":null,\"service_tier\":\"default\",\"store\":false,\"temperature\":1.0,\"text\":{\"format\":{\"type\":\"text\"},\"verbosity\":\"medium\"},\"tool_choice\":\"auto\",\"tool_usage\":{\"image_gen\":{\"input_tokens\":0,\"input_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"output_tokens\":0,\"output_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"total_tokens\":0},\"web_search\":{\"num_requests\":0}},\"tools\":[{\"type\":\"function\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\\n\\nmail, calendar, drive are not tools you call directly: reach them from bash with the `tools` command. `tools list` shows them, `tools list <tool> --schema` a tool's commands and arguments, `tools call <tool>.<command> --json -` with the arguments on stdin in a quoted heredoc (`<<'JSON'`), so quotes in them need no escaping, makes one call, and `tools run` with a script on stdin (`await tools.<tool>.<command>({...})`) makes several.\",\"name\":\"bash\",\"outp