. Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"name\":\"read\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"strict\":true}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":null,\"user\":null,\"metadata\":{}},\"sequence_number\":1}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"rs_0ca47290c08bdb92016af127f3d5a487d09c31b8f4258347ee\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"gAAAAABq8Sfz9TiClRLm133WCafNK_AcQxsd0yt6H8hZVuHwK-ocK-iz-CmXyCD7MHabFyiNWa3noznsmZ3BgWKV-0SZ9z9znKQqQgRn0UVYwKTM6tmKP4fChhonHyZAyeCEilMuF6glUXm1I7aWwzQIawlDL8zCPRcf6RX5ilbXM4CudXgAVWVv6ZMpaAcKlTxYWPEtQKF2ZQvsyyu2IojkVdHILtz23z8sex_f1zDnz7mU5d6ztvbchMaNTDbSyrBvo3iz3JnLRZuyBlkMuHYnjZhQkRD5iNDi1JD-9E_VquZYer8afYkxjdumC0SXgE6AyRCjloTrTKC9WFctttXvvJS1SLsPH3HNt5201EnC83a20QOKswFFbrINGa4kC4uf4ey19-9q7niAPHMu79GOvso-w1zX98YUx3-9Jc1xF1lN3BUbcDYTxgFI_Bt6VsTunkxxxJ7cjgfj2BrCehfJ9gTUZarNrGdw-waQ7ZTID4sHfcbnxKqRdYbjV6byIeNWoxNyTQqOhegspPESVcINCWXYqz8bs-7lp8KDTf9BW60R2Vb_ANnsScVw_QLAYcE39Vf8R358ScU30_CCeUgdQFNMakXeK_2GYSwnhSf_gsHYZnwW-UxfzFzRUDRrdmAi5TuzVXfk7HMkXTlff1oEcqELcRgtDiqn7gzg-5SvbE1R9TO1ycgGPSWH8RvfvHyWMq8_X2bnIHrqu8IUhoW2wQn7VnuF7pUJ9gyoobRhi2P2cqwMnoOZg-uQKTCia0WlFJe_M2t1Zm8MXZOUR9z3xFCd9pK-8M68DV4Oj5vvT2LZv9lYI0tEI7t-tY7a1R-0a6ODC5H3vK2GQWGRjIYxR_DSsuMT4H8afEV1TrnZYACzANfM7QmM