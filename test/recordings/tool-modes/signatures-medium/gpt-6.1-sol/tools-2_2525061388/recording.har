ly. Google Docs, Sheets and Slides are read as text (a Sheet as CSV of its first sheet over REST); Google refuses exports above 10 MB.\"},{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"download\"},\"file\":{\"type\":\"string\",\"description\":\"A file handle (file_…)\",\"minLength\":1}},\"required\":[\"command\",\"file\"],\"additionalProperties\":false,\"description\":\"Save a file to the session's downloads, exporting native documents to Office formats, for the documents tool. Returns its path. Reads only. Google Docs, Sheets and Slides download as .docx, .xlsx and .pptx.\"},{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"upload\"},\"path\":{\"type\":\"string\",\"description\":\"A file under outputs/\",\"minLength\":1},\"folder\":{\"type\":\"string\",\"description\":\"A folder's file handle; without it, the whole drive, or its root for upload\",\"minLength\":1},\"name\":{\"type\":\"string\",\"description\":\"The new file's name; default the local file's name\",\"minLength\":1,\"maxLength\":255}},\"required\":[\"command\",\"path\"],\"additionalProperties\":false,\"description\":\"Upload a file from outputs/ as a new file. Returns its handle. Changes the person's data; can be undone.\"}]},\"strict\":false}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":{\"input_tokens\":4763,\"input_tokens_details\":{\"cache_write_tokens\":4760,\"cached_tokens\":0},\"output_tokens\":46,\"output_tokens_details\":{\"reasoning_tokens\":0},\"total_tokens\":4809},\"user\":null,\"metadata\":{}},\"sequence_number\":39}\n\n"
