\":\"function_call\",\"id\":\"fc_01aa21748ba59380016af13c06ed5087d08f7df1d7ea009791\",\"call_id\":\"call_y9oeXXe1qsUcWri7Fj9Dgbgn\",\"name\":\"drive\",\"arguments\":\"{\\\"command\\\":\\\"read\\\",\\\"file\\\":\\\"file_8ee3855a11534f2a\\\"}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_uAbu704zPIgCerZP5SQjXXr5\",\"output\":\"{\\n  \\\"messages\\\": [\\n    {\\n      \\\"message\\\": \\\"msg_f3f90f0802404bb3\\\",\\n      \\\"thread\\\": \\\"thr_422e3c0e84534df1\\\",\\n      \\\"from\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"to\\\": [\\n        {\\n          \\\"email\\\": \\\"me@example.test\\\",\\n          \\\"name\\\": \\\"Sam Example\\\"\\n        }\\n      ],\\n      \\\"subject\\\": \\\"Q3 budget numbers\\\",\\n      \\\"snippet\\\": \\\"Can you bring the latest budget sheet to tomorrow's review?\\\",\\n      \\\"sent_at\\\": \\\"2026-11-09T08:12:00Z\\\",\\n      \\\"unread\\\": true,\\n      \\\"labels\\\": [\\n        \\\"INBOX\\\",\\n        \\\"UNREAD\\\"\\n      ],\\n      \\\"body\\\": {\\n        \\\"text\\\": \\\"Hi Sam,\\\\n\\\\nCan you bring the latest budget sheet to tomorrow's planning review? Finance wants the Q3 travel line.\\\\n\\\\nThanks,\\\\nDana\\\",\\n        \\\"truncated\\\": false,\\n        \\\"limit_chars\\\": 20000\\n      },\\n      \\\"attachments\\\": []\\n    }\\n  ]\\n}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_y9oeXXe1qsUcWri7Fj9Dgbgn\",\"output\":\"{\\n  \\\"file\\\": \\\"file_8ee3855a11534f2a\\\",\\n  \\\"name\\\": \\\"Q3 Budget\\\",\\n  \\\"mime_type\\\": \\\"application/vnd.google-apps.spreadsheet\\\",\\n  \\\"modified_at\\\": \\\"2026-11-08T17:00:00Z\\\",\\n  \\\"modified_by\\\": \\\"Dana Example\\\",\\n  \\\"native_type\\\": \\\"spreadsheet\\\",\\n  \\\"web_url\\\": \\\"https://docs.example.test/spreadsheets/d/f-budget\\\",\\n  \\\"text\\\": {\\n    \\\"text\\\": \\\"line,q2,q3\\\\ntravel,12000,15500\\\\nsoftware,8000,8200\\\\nevents,4000,6500\\\",\\n    \\\"truncated\\\": false,\\n    \\\"limit_chars\\\": 100000\\n  },\\n  \\\"exported_as\\\": \\\"text/csv\\\"\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"medium\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be52-669f-7442-a54e-d833e5606d6f\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
          },
