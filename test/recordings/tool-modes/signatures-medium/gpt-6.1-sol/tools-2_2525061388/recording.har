ive\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\",\"enum\":[\"search\",\"read\",\"download\",\"upload\"]},\"query\":{\"type\":\"string\",\"description\":\"Words to search for\",\"minLength\":1,\"maxLength\":1000},\"folder\":{\"type\":\"string\",\"description\":\"A folder's file handle; without it, the whole drive, or its root for upload\",\"minLength\":1},\"modified_after\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"limit\":{\"type\":\"integer\",\"description\":\"At most this many results\",\"minimum\":1,\"maximum\":100,\"default\":25},\"cursor\":{\"type\":\"string\",\"description\":\"A cursor from the previous page, with the same arguments\",\"minLength\":1},\"file\":{\"type\":\"string\",\"description\":\"A file handle (file_…)\",\"minLength\":1},\"path\":{\"type\":\"string\",\"description\":\"A file under outputs/\",\"minLength\":1},\"name\":{\"type\":\"string\",\"description\":\"The new file's name; default the local file's name\",\"minLength\":1,\"maxLength\":255}},\"required\":[\"command\"],\"additionalProperties\":false,\"anyOf\":[{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"search\"},\"query\":{\"type\":\"string\",\"description\":\"Words to search for\",\"minLength\":1,\"maxLength\":1000},\"folder\":{\"type\":\"string\",\"description\":\"A folder's file handle; without it, the whole drive, or its root for upload\",\"minLength\":1},\"modified_after\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"limit\":{\"type\":\"integer\",\"description\":\"At most this many results\",\"minimum\":1,\"maximum\":100,\"default\":25},\"cursor\":{\"type\":\"string\",\"description\":\"A cursor from the previous page, with the same arguments\",\"minLength\":1}},\"required\":[\"command\",\"query\"],\"additionalProperties\":false,\"description\":\"Search the person's files. Returns file handles. Reads only.\"},{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"read\"},\"file\":{\"type\":\"string\",\"description\":\"A file handle (file_…)\",\"minLength\":1}},\"required\":[\"command\",\"file\"],\"additionalProperties\":false,\"description\":\"A file's metadata and text, exported from native formats. Text is cut at 100000 characters; a cut text says so. To edit a file, use drive download. Reads only. Google Docs, Sheets and Slides are read as text (a Sheet as CSV of its first sheet over REST); Google refuses exports above 10 MB.\"},{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"download\"},\"file\":{\"type\":\"string\",\"description\":\"A file handle (file_…)\",\"minLength\":1}},\"required\":[\"command\",\"file\"],\"additionalProperties\":false,\"description\":\"Save a file to the session's downloads, exporting native documents to Office formats, for the documents tool. Returns its path. Reads only. Google Docs, Sheets and Slides download as .docx, .xlsx and .pptx.\"},{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"upload\"},\"path\":{\"type\":\"string\",\"description\":\"A file under outputs/\",\"minLength\":1},\"folder\":{\"type\":\"string\",\"description\":\"A folder's file handle; without it, the whole drive, or its root for upload\",\"minLength\":1},\"name\":{\"type\":\"string\",\"description\":\"The new file's name; default the local file's name\",\"minLength\":1,\"maxLength\":255}},\"required\":[\"command\",\"path\"],\"additionalProperties\":false,\"description\":\"Upload a file from outputs/ as a new file. Returns its handle. Changes the person's data; can be undone.\"}]},\"strict\":false}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":null,\"user\":null,\"metadata\":{}},\"sequence_number\":1}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"rs_01aa21748ba59380016af13c06222087d0b5ebcc3135df329a\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"gAAAAABq8TwGC--URFq5dMNXrTmYGYRVKx