\ndata: {\"type\":\"content_block_stop\",\"index\":1   }\n\nevent: message_delta\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1151,\"cache_read_input_tokens\":8266,\"output_tokens\":286,\"output_tokens_details\":{\"thinking_tokens\":46}}          }\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"          }\n\n"
