ean\\\"},\\\"limit\\\":{\\\"type\\\":\\\"integer\\\",\\\"minimum\\\":1,\\\"maximum\\\":100,\\\"description\\\":\\\"At most this many results (default 25)\\\"},\\\"cursor\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A cursor from the previous page, with the same arguments\\\"}}\\nmail.read {\\\"message\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A message handle (msg_…)\\\"},\\\"thread\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A thread handle (thr_…)\\\"}}\\nmail.fetch_attachment {\\\"attachment\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"An attachment handle (att_…) from mail read\\\"}}\\nmail.draft {\\\"to\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":3,\\\"maxLength\\\":320},\\\"maxItems\\\":100,\\\"description\\\":\\\"Recipient addresses\\\"},\\\"cc\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":3,\\\"maxLength\\\":320},\\\"maxItems\\\":100,\\\"description\\\":\\\"Copied addresses\\\"},\\\"subject\\\":{\\\"type\\\":\\\"string\\\",\\\"maxLength\\\":1000},\\\"body\\\":{\\\"type\\\":\\\"string\\\",\\\"maxLength\\\":200000,\\\"description\\\":\\\"Markdown\\\"},\\\"reply_to\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A message handle to reply to\\\"}}\\nmail.update_draft {\\\"draft\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A draft handle from mail draft\\\"},\\\"to\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":3,\\\"maxLength\\\":320},\\\"maxItems\\\":100,\\\"description\\\":\\\"Recipient addresses\\\"},\\\"cc\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":3,\\\"maxLength\\\":320},\\\"maxItems\\\":100,\\\"description\\\":\\\"Copied addresses\\\"},\\\"subject\\\":{\\\"type\\\":\\\"string\\\",\\\"maxLength\\\":1000},\\\"body\\\":{\\\"type\\\":\\\"string\\\",\\\"maxLength\\\":200000,\\\"description\\\":\\\"Markdown\\\"}}\\nmail.send {\\\"draft\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A draft handle from mail draft\\\"}}\\nmail.move {\\\"message\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A message handle\\\"},\\\"folder\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"maxLength\\\":200,\\\"description\\\":\\\"A label name\\\"}}\\nmail.label {\\\"message\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A message handle\\\"},\\\"add\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"maxLength\\\":200},\\\"maxItems\\\":50},\\\"remove\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"maxLength\\\":200},\\\"maxItems\\\":50}}\\ndrive.search {\\\"query\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"maxLength\\\":1000},\\\"folder\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A folder's file handle\\\"},\\\"modified_after\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"RFC 3339 time with offset\\\"},\\\"limit\\\":{\\\"type\\\":\\\"integer\\\",\\\"minimum\\\":1,\\\"maximum\\\":100,\\\"description\\\":\\\"At most this many results (default 25)\\\"},\\\"cursor\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A cursor from the previous page, with the same arguments\\\"}}\\ndrive.read {\\\"file\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A file handle (file_…)\\\"}}\\ndrive.download {\\\"file\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A file handle\\\"}}\\ndrive.upload {\\\"path\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A file under outputs/\\\"},\\\"folder\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"description\\\":\\\"A folder's file handle; default the drive's root\\\"},\\\"name\\\":{\\\"type\\\":\\\"string\\\",\\\"minLength\\\":1,\\\"maxLength\\\":255}}\\nSun Nov  8 15:42:41 PST 2026\\n\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"Tomorrow is Monday, November 9, since today is Sunday, November 8. I don't know the user's time zone, but the machine clock reads PST, so I'll go with America/Los_Angeles. I'll run the calendar lookup for tomorrow, the mail search for Dana's budget, and the Drive search for the budget at the same time.\\n\\n\",\"signature\":\"\"},{\"type\":\"tool_use\",\"id\":\"toolu_0195vjHrJcgKK43zxJkFpFUU\",\"name\":\"bash\",\"input\":{\"command\":\"tools call calendar.list --json '{\\\"from\\\":\\\"2026-11-09T00:00:00-08:00\\\",\\\"to\\\":\\\"2026-11-10T00:00:00-08:00\\\",\\\"limit\\\":50}'; echo ---; tools call mail.search --json '{\\\"query\\\":\\\"budget\\\",\\\"from\\\":\\\"Dana\\\",\\\"limit\\\":10}'; echo ---; tools call drive.search --json '{\\\"query\\\":\\\"budget\\\",\\\"limit\\\":10}'\",\"timeout\":90}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_0195vjHrJcgKK43zxJkFpFUU\",\"content\":\"{\\n  \\\"events\\\": [\\n    {\\n      \\\"event\\\": \\\"evt_3846739cf0514502\\\",\\n      \\\"title\\\": \\\"Team standup\\\",\\n      \\\"start\\\": \\\"2026-11-09T09:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-09T09:15:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"lee@example.test\\\",\\n        \\\"name\\\": \\\"Lee Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    },\\n    {\\n      \\\"event\\\": \\\"evt_2a8dee3ef8bb43aa\\\",\\n      \\\"title\\\": \\\"Q3 planning review\\\",\\n      \\\"start\\\": \\\"2026-11-09T14:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-09T15:00:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"location\\\": \\\"Room 4\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    }\\n  ]\\n}\\n---\\n{\\n  \\\"messages\\\": [\\n    {\\n      \\\"message\\\": \\\"msg_45244645bb99488d\\\",\\n      \\\"thread\\\": \\\"thr_6d0ed89f177b4abb\\\",\\n      \\\"from\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"to\\\": [\\n        {\\n          \\\"email\\\": \\\"me@example.test\\\",\\n          \\\"name\\\": \\\"Sam Example\\\"\\n        }\\n      ],\\n      \\\"subject\\\": \\\"Q3 budget numbers\\\",\\n      \\\"snippet\\\": \\\"Can you bring the latest budget sheet to tomorrow's review?\\\",\\n      \\\"sent_at\\\": \\\"2026-11-08T08:12:00Z\\\",\\n      \\\"unread\\\": true,\\n      \\\"labels\\\": [\\n        \\\"INBOX\\\",\\n        \\\"UNREAD\\\"\\n      ]\\n    }\\n  ]\\n}\\n---\\n{\\n  \\\"files\\\": [\\n    {\\n      \\\"file\\\": \\\"file_c9557c18ced04090\\\",\\n      \\\"name\\\": \\\"Q3 Budget\\\",\\n      \\\"mime_type\\\": \\\"application/vnd.google-apps.spreadsheet\\\",\\n      \\\"modified_at\\\": \\\"2026-11-07T17:00:00Z\\\",\\n      \\\"modified_by\\\": \\\"Dana Example\\\",\\n      \\\"native_type\\\": \\\"spreadsheet\\\",\\n      \\\"web_url\\\": \\\"https://docs.example.test/spreadsheets/d/f-budget\\\"\\n    }\\n  ]\\n}\\n\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"I'm checking the calendar times, which come back in UTC while my query was set to PST. The standup at 09:00Z and the other event at 14:00Z both land inside the PST day window, so the results still hold. I'm not yet sure which timezone the user is in.\\n\\nI'll stick with UTC and mention it in my reply. Next I want to open the full Dana email, since the snippet mentions bringing the budget sheet and I want the rest of the message before drafting the reply with the link.\\n\\n\",\"signature\":\"\"},{\"type\":\"tool_use\",\"id\":\"toolu_01Fn5Gzd8wu7eGx1P2u8ibbw\",\"name\":\"bash\",\"input\":{\"command\":\"tools call mail.read --json '{\\\"message\\\":\\\"msg_45244645bb99488d\\\"}'; echo ---; tools call calendar.read --json '{\\\"event\\\":\\\"evt_2a8dee3ef8bb43aa\\\"}'\",\"timeout\":90}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_01Fn5Gzd8wu7eGx1P2u8ibbw\",\"content\":\"{\\n  \\\"messages\\\": [\\n    {\\n      \\\"message\\\": \\\"msg_45244645bb99488d\\\",\\n      \\\"thread\\\": \\\"thr_6d0ed89f177b4abb\\\",\\n      \\\"from\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"to\\\": [\\n        {\\n          \\\"email\\\": \\\"me@example.test\\\",\\n          \\\"name\\\": \\\"Sam Example\\\"\\n        }\\n      ],\\n      \\\"subject\\\": \\\"Q3 budget numbers\\\",\\n      \\\"snippet\\\": \\\"Can you bring the latest budget sheet to tomorrow's review?\\\",\\n      \\\"sent_at\\\": \\\"2026-11-08T08:12:00Z\\\",\\n      \\\"unread\\\": true,\\n      \\\"labels\\\": [\\n        \\\"INBOX\\\",\\n        \\\"UNREAD\\\"\\n      ],\\n      \\\"body\\\": {\\n        \\\"text\\\": \\\"Hi Sam,\\\\n\\\\nCan you bring the latest budget sheet to tomorrow's planning review? Finance wants the Q3 travel line.\\\\n\\\\nThanks,\\\\nDana\\\",\\n        \\\"truncated\\\": false,\\n        \\\"limit_chars\\\": 20000\\n      },\\n      \\\"attachments\\\": []\\n    }\\n  ]\\n}\\n---\\n{\\n  \\\"event\\\": \\\"evt_2a8dee3ef8bb43aa\\\",\\n  \\\"title\\\": \\\"Q3 planning review\\\",\\n  \\\"start\\\": \\\"2026-11-09T14:00:00Z\\\",\\n  \\\"end\\\": \\\"2026-11-09T15:00:00Z\\\",\\n  \\\"time_zone\\\": \\\"UTC\\\",\\n  \\\"location\\\": \\\"Room 4\\\",\\n  \\\"organizer\\\": {\\n    \\\"email\\\": \\\"dana@example.test\\\",\\n    \\\"name\\\": \\\"Dana Example\\\"\\n  },\\n  \\\"response\\\": \\\"accepted\\\",\\n  \\\"attendees\\\": [\\n    {\\n      \\\"email\\\": \\\"me@example.test\\\",\\n      \\\"name\\\": \\\"Sam Example\\\"\\n    },\\n    {\\n      \\\"email\\\": \\\"dana@example.test\\\",\\n      \\\"name\\\": \\\"Dana Example\\\"\\n    },\\n    {\\n      \\\"email\\\": \\\"lee@example.test\\\",\\n      \\\"name\\\": \\\"Lee Example\\\"\\n    }\\n  ],\\n  \\\"body\\\": {\\n    \\\"text\\\": \\\"Budget and hiring plan.\\\",\\n    \\\"truncated\\\": false,\\n    \\\"limit_chars\\\": 20000\\n  }\\n}\\n\",\"is_error\":false}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_017GkmD9oFSNSSZYHn5Bs8Hp\",\"name\":\"bash\",\"input\":{\"command\":\"tools call mail.draft --json '{\\\"reply_to\\\":\\\"msg_45244645bb99488d\\\",\\\"to\\\":[\\\"dana@example.test\\\"],\\\"body\\\":\\\"Hi Dana,\\\\n\\\\nYes, I will bring the Q3 budget sheet to the planning review tomorrow. Here is the link:\\\\n\\\\nhttps://docs.example.test/spreadsheets/d/f-budget\\\\n\\\\nThanks,\\\\nSam\\\"}'\",\"timeout\":90}}]},{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_017GkmD9oFSNSSZYHn5Bs8Hp\",\"content\":\"Validation failed for tool \\\"mail\\\":\\n  - subject: missing\\n\\nReceived arguments:\\n{\\n  \\\"reply_to\\\": \\\"msg_45244645bb99488d\\\",\\n  \\\"to\\\": [\\n    \\\"dana@example.test\\\"\\n  ],\\n  \\\"body\\\": \\\"Hi Dana,\\\\n\\\\nYes, I will bring the Q3 budget sheet to the planning review tomorrow. Here is the link:\\\\n\\\\nhttps://docs.example.test/spreadsheets/d/f-budget\\\\n\\\\nThanks,\\\\nSam\\\",\\n  \\\"command\\\": \\\"draft\\\"\\n}\\n\\n\\nCommand exited with code 1\",\"is_error\":true,\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a conformance fixture.\\n\\nConformance agent\\n\\n<skills>\\nThe following skills provide specialized instructions for specific tasks.\\nUse the read tool to load a skill's file when the task matches its description.\\nResolve relative paths against the skill's directory (parent of SKILL.md). Use absolute paths in tool calls.\\n\\n<available_skills>\\n  <skill>\\n    <name>productivity</name>\\n    <description>How to use the mail, calendar and drive tools well. Load it before searching, reading, drafting or sending mail, scheduling or answering meetings, or finding, reading or uploading files.</description>\\n    <location>/repo/skills/productivity/SKILL.md</location>\\n  </skill>\\n</available_skills>\\n</skills>\\n\\n<cwd>\\n/tmp/recipe-conformance-dEFkFE/workspace\\n</cwd>\",\"cache_control\":{\"type\":\"ephemeral\"}}],\"tools\":[{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\\n\\nmail, calendar, drive are not tools you call directly: reach them from bash with the `tools` command. `tools list` shows them, `tools list <tool> --schema` a tool's commands and arguments, `tools call <tool>.<command> --json '{...}'` makes one call, and `tools run` with a script on stdin (`await tools.<tool>.<command>({...})`) makes several.\",\"eager_input_streaming\":true,\"strict\":true,\"input_schema\":{\"type\":\"object\",\"required\":[\"command\",\"timeout\"],\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"Shell command to execute\"},\"timeout\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Timeout in seconds (optional, no default timeout)\"},{\"type\":\"null\"}]}},\"additionalProperties\":false}},{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"eager_input_streaming\":true,\"strict\":true,\"input_schema\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"cache_control\":{\"type\":\"ephemeral\"}},{\"name\":\"__pi_deferred_placeholder__\",\"description\":\"Reserved placeholder. Never available. Never call this.\",\"input_schema\":{\"type\":\"object\",\"properties\":{},\"required\":[]},\"defer_loading\":true}],\"thinking\":{\"type\":\"adaptive\",\"display\":\"summarized\",\"block_binding\":{\"prefix_mismatch_behavior\":\"drop_block\"}},\"output_config\":{\"effort\":\"low\"}}"
