d\":\"toolu_012aYaMKPEX9FxcCE2ow5heA\",\"name\":\"mail\",\"input\":{},\"caller\":{\"type\":\"direct\"}}         }\n\nevent: content_block_delta\ndata: {\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"command\\\": \\\"draft\\\", \\\"reply_to\\\": \\\"msg_4fa23cbde49642a4\\\", \\\"to\\\": [\\\"dana@example.test\\\"], \\\"subject\\\": \\\"Re: Q3 budget numbers\\\", \\\"body\\\": \\\"Hi Dana,\\\\n\\\\nI'll bring the Q3 budget sheet to tomorrow's planning review. Here's the link: https://docs.example.test/spreadsheets/d/f-budget\\\\n\\\\nThanks,\\\\nSam\\\"}\"}}\n\nevent: content_block_stop\ndata: {\"type\":\"content_block_stop\",\"index\":1       }\n\nevent: message_delta\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1098,\"cache_read_input_tokens\":8132,\"output_tokens\":305,\"output_tokens_details\":{\"thinking_tokens\":66}}          }\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"             }\n\n"
