. Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"name\":\"read\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"strict\":true}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":null,\"user\":null,\"metadata\":{}},\"sequence_number\":1}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"fc_0af7e707a57bed81016af113d9028087d097e03a13e5d3ed03\",\"type\":\"function_call\",\"status\":\"in_progress\",\"arguments\":\"\",\"call_id\":\"call_T2o65DcEu0n8ik8JTuMxd0rv\",\"name\":\"bash\"},\"output_index\":0,\"sequence_number\":2}\n\nevent: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\\\"command\\\":\\\"tools run <<'EOF'\\\\nconst a=await Promise.all([tools.calendar.list({from:'2026-11-09T00:00:00-08:00',to:'2026-11-10T00:00:00-08:00'}),tools.mail.search({query:'budget Dana',limit:10}),tools.drive.search({query:'budget spreadsheet',limit:10})]); console.log(JSON.stringify(a))\\\\nEOF\\\",\\\"timeout\\\":20}\",\"item_id\":\"fc_0af7e707a57bed81016af113d9028087d097e03a13e5d3ed03\",\"obfuscation\":\"aLORrPnVlxFacl\",\"output_index\":0,\"sequence_number\":3}\n\nevent: response.function_call_arguments.done\ndata: {\"type\":\"response.function_call_arguments.done\",\"arguments\":\"{\\\"command\\\":\\\"tools run <<'EOF'\\\\ncon