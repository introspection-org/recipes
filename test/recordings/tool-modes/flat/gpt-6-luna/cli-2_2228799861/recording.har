ments.done\",\"arguments\":\"{\\\"command\\\":\\\"tools run <<'EOF'\\\\nconst x=await tools.mail.draft({to:['dana@example.test'],subject:'Re: Q3 budget numbers',body:\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI'll bring the budget sheet to the meeting: https://docs.example.test/spreadsheets/d/f-budget\\\\\\\\n\\\\\\\\nBest,\\\\\\\\nSam\\\\\\\",reply_to:'msg_84c05d3972fb4fce'}); console.log(JSON.stringify(x))\\\\nEOF\\\",\\\"timeout\\\":10}\",\"item_id\":\"fc_0af7e707a57bed81016af113dc0c6087d095e72592dc5c4e38\",\"output_index\":0,\"sequence_number\":108}\n\nevent: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"item\":{\"id\":\"fc_0af7e707a57bed81016af113dc0c6087d095e72592dc5c4e38\",\"type\":\"function_call\",\"status\":\"completed\",\"arguments\":\"{\\\"command\\\":\\\"tools run <<'EOF'\\\\nconst x=await tools.mail.draft({to:['dana@example.test'],subject:'Re: Q3 budget numbers',body:\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI'll bring the budget sheet to the meeting: https://docs.example.test/spreadsheets/d/f-budget\\\\\\\\n\\\\\\\\nBest,\\\\\\\\nSam\\\\\\\",reply_to:'msg_84c05d3972fb4fce'}); console.log(JSON.stringify(x))\\\\nEOF\\\",\\\"timeout\\\":10}\",\"call_id\":\"call_mISbfTRw9kDI70bJZwlP3IgJ\",\"name\":\"bash\"},\"output_index\":0,\"sequence_number\":109}\n\nevent: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_0af7e707a57bed81016af113db2b5487d096257ab47df15c47\",\"object\":\"response\",\"created_at\":1794184155,\"status\":\"completed\",\"access_programs\":null,\"background\":false,\"completed_at\":1794184156,\"error\":null,\"frequency_penalty\":0.0,\"image\":{\"context_compression\":\"disabled\"},\"incomplete_details\":null,\"instructions\":null,\"max_output_tokens\":128000,\"max_tool_calls\":null,\"model\":\"gpt-6-luna\",\"moderation\":null,\"output\":[{\"id\":\"fc_0af7e707a57bed81016af113dc0c6087d095e72592dc5c4e38\",\"type\":\"function_call\",\"status\":\"completed\",\"arguments\":\"{\\\"command\\\":\\\"tools run <<'EOF'\\\\nconst x=await tools.mail.draft({to:['dana@example.test'],subject:'Re: Q3 budget numbers',body:\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI'll bring the budget sheet to the meeting: https://docs.example.test/spreadsheets/d/f-budget\\\\\\\\n\\\\\\\\nBest,\\\\\\\\nSam\\\\\\\",reply_to:'msg_84c05d3972fb4fce'}); console.log(JSON.stringify(x))\\\\nEOF\\\",\\\"timeout\\\":10}\",\"call_id\":\"call_mISbfTRw9kDI70bJZwlP3IgJ\",\"name\":\"bash\"}],\"parallel_tool_calls\":true,\"presence_penalty\":0.0,\"previous_response_id\":null,\"prompt_cache_key\":\"01a1bdb5-7737-76d5-b268-a2f0ed3ed119\",\"prompt_cache_retention\":\"24h\",\"reasoning\":{\"context\":\"all_turns\",\"effort\":\"medium\",\"mode\":\"standard\",\"summary\":\"detailed\"},\"safety_identifier\":null,\"service_tier\":\"default\",\"store\":false,\"temperature\":1.0,\"text\":{\"format\":{\"type\":\"text\"},\"verbosity\":\"medium\"},\"tool_choice\":\"auto\",\"tool_usage\":{\"image_gen\":{\"input_tokens\":0,\"input_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"output_tokens\":0,\"output_tokens_details\":{\"image_tokens\":0,\"text_tokens\":0},\"total_tokens\":0},\"web_search\":{\"num_requests\":0}},\"tools\":[{\"type\":\"function\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\\n\\nmail, calendar, drive are not tools you call directly: reach them from bash with the `tools` command. `tools list` shows them, `tools list <tool> --schema` a tool's commands and arguments, `tools call <tool>.<command> --json -` with the arguments on stdin in a quoted heredoc (`<<'JSON'`), so quotes in them need no escaping, makes one call, and `tools run` with a script on stdin (`await tools.<tool>.<command>({...})`) makes several.\",\"name\":\"bash\",\"output_schema\":null,\"parameters\":{\"type\":\"objec