f11775ec8887d0917be88235e8605d\",\"call_id\":\"call_CNj794bFnZMx0nsRImmwmfJU\",\"name\":\"mail\",\"arguments\":\"{\\\"command\\\":\\\"draft\\\",\\\"to\\\":[\\\"dana@example.test\\\"],\\\"subject\\\":\\\"Re: Q3 budget numbers\\\",\\\"body\\\":\\\"Hi Dana,\\\\n\\\\nI'll bring the latest [Q3 Budget sheet](https://docs.example.test/spreadsheets/d/f-budget) to the planning review, including the Q3 travel line for Finance.\\\\n\\\\nThanks,\\\\nSam\\\",\\\"reply_to\\\":\\\"msg_9b7ae5e50a1244ef\\\"}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_CNj794bFnZMx0nsRImmwmfJU\",\"output\":\"{\\n  \\\"draft\\\": \\\"msg_aa2b7548b822455b\\\",\\n  \\\"thread\\\": \\\"thr_0dbb5d1be11946b6\\\",\\n  \\\"to\\\": [\\n    {\\n      \\\"email\\\": \\\"dana@example.test\\\"\\n    }\\n  ],\\n  \\\"subject\\\": \\\"Re: Q3 budget numbers\\\"\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"low\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1bdc3-87d4-7250-8242-77da71db9e64\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
