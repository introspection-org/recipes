:{\"command\":{\"type\":\"string\",\"const\":\"free_busy\"},\"attendees\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":320},\"minItems\":1,\"maxItems\":50},\"from\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"to\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"time_zone\":{\"type\":\"string\",\"minLength\":1,\"description\":\"IANA time zone for the result\"}},\"additionalProperties\":false,\"description\":\"Busy intervals for each attendee between two times. Reads only.\"},{\"type\":\"object\",\"required\":[\"command\",\"title\",\"start\",\"end\",\"time_zone\"],\"properties\":{\"command\":{\"type\":\"string\",\"const\":\"create\"},\"title\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1000},\"start\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"end\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"time_zone\":{\"type\":\"string\",\"minLength\":1,\"description\":\"IANA time zone, such as America/New_York\"},\"all_day\":{\"type\":\"boolean\"},\"attendees\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":320},\"maxItems\":100,\"description\":\"Attendee addresses\"},\"location\":{\"type\":\"string\",\"maxLength\":1000},\"body\":{\"type\":\"string\",\"maxLength\":100000,\"description\":\"Markdown\"},\"online_meeting\":{\"type\":\"boolean\",\"description\":\"Add an online meeting link\"}},\"additionalProperties\":false,\"description\":\"Create an event. With attendees, invitations go out at once. Notifies other people.\"},{\"type\":\"object\",\"required\":[\"command\",\"event\"],\"properties\":{\"command\":{\"type\":\"string\",\"const\":\"update\"},\"event\":{\"type\":\"string\",\"minLength\":1,\"description\":\"An event handle\"},\"title\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1000},\"start\":{\"type\":\"string\"},\"end\":{\"