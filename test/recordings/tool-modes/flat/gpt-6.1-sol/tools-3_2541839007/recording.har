ent\":[{\"type\":\"input_text\",\"text\":\"What's on my calendar tomorrow, and did Dana email about the budget? Find the budget spreadsheet in my Drive, then draft a reply to Dana saying I'll bring it to the meeting, with a link to the sheet. Don't send it.\"}]},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"low\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1bdc3-87d4-7250-8242-77da71db9e64\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
