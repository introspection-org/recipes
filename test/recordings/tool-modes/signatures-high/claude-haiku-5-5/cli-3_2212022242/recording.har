ype\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"command\\\": \\\"date; date -u; cat /etc/timezone 2>/dev/null; readlink /etc/localtime\\\", \\\"timeout\\\": 30}\"}}\n\nevent: content_block_stop\ndata: {\"type\":\"content_block_stop\",\"index\":1  }\n\nevent: content_block_start\ndata: {\"type\":\"content_block_start\",\"index\":2,\"content_block\":{\"type\":\"tool_use\",\"id\":\"toolu_01KXeHA7jw2TR6Nzyuy9JUd9\",\"name\":\"bash\",\"input\":{},\"caller\":{\"type\":\"direct\"}}}\n\nevent: content_block_delta\ndata: {\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"command\\\": \\\"tools call mail.search --json - <<'JSON'\\\\n{\\\\\\\"query\\\\\\\":\\\\\\\"budget\\\\\\\",\\\\\\\"from\\\\\\\":\\\\\\\"Dana\\\\\\\",\\\\\\\"limit\\\\\\\":10}\\\\nJSON\\\\necho ---\\\\ntools call drive.search --json - <<'JSON'\\\\n{\\\\\\\"query\\\\\\\":\\\\\\\"budget\\\\\\\",\\\\\\\"limit\\\\\\\":25}\\\\nJSON\\\", \\\"timeout\\\": 90}\"}}\n\nevent: content_block_stop\ndata: {\"type\":\"content_block_stop\",\"index\":2    }\n\nevent: message_delta\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2994,\"cache_read_input_tokens\":2837,\"output_tokens\":325,\"output_tokens_details\":{\"thinking_tokens\":74}}}\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"               }\n\n"
