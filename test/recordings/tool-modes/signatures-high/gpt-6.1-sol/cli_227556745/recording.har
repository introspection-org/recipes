@ 4 user  staff  128 Nov  8 18:07 ..\\ndrwxr-xr-x@ 3 user  staff   96 Nov  8 18:07 .pi\\n{\\\"kind\\\":\\\"mail\\\",\\\"result\\\":{\\\"messages\\\":[{\\\"message\\\":\\\"msg_18045a14f253441e\\\",\\\"thread\\\":\\\"thr_2db88e631fee48fc\\\",\\\"from\\\":{\\\"email\\\":\\\"dana@example.test\\\",\\\"name\\\":\\\"Dana Example\\\"},\\\"to\\\":[{\\\"email\\\":\\\"me@example.test\\\",\\\"name\\\":\\\"Sam Example\\\"}],\\\"subject\\\":\\\"Q3 budget numbers\\\",\\\"snippet\\\":\\\"Can you bring the latest budget sheet to tomorrow's review?\\\",\\\"sent_at\\\":\\\"2026-11-09T08:12:00Z\\\",\\\"unread\\\":true,\\\"labels\\\":[\\\"INBOX\\\",\\\"UNREAD\\\"]}]}}\\n{\\\"kind\\\":\\\"drive\\\",\\\"result\\\":{\\\"files\\\":[{\\\"file\\\":\\\"file_48e244f56ec64da3\\\",\\\"name\\\":\\\"Q3 Budget\\\",\\\"mime_type\\\":\\\"application/vnd.google-apps.spreadsheet\\\",\\\"modified_at\\\":\\\"2026-11-08T17:00:00Z\\\",\\\"modified_by\\\":\\\"Dana Example\\\",\\\"native_type\\\":\\\"spreadsheet\\\",\\\"web_url\\\":\\\"https://docs.example.test/spreadsheets/d/f-budget\\\"}]}}\\nnull\\n\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be0f-ca73-74db-86aa-00f08e4aaac4\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
