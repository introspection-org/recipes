\"id\":\"fc_0b448754b198ab42016af1295aa9e887d09ee2ed17b672ec4b\",\"call_id\":\"call_2xHlz951kHP3LpBuDMb0ToEo\",\"name\":\"drive\",\"arguments\":\"{\\\"command\\\":\\\"read\\\",\\\"file\\\":\\\"file_e07ee01f14a646aa\\\"}\"},{\"type\":\"function_call\",\"id\":\"fc_0b448754b198ab42016af1295aa9f487d09219f024f5fb9e7d\",\"call_id\":\"call_0kB8CmX73aSmpsNxZe6xFYOi\",\"name\":\"calendar\",\"arguments\":\"{\\\"command\\\":\\\"list\\\",\\\"from\\\":\\\"2026-11-10T00:00:00Z\\\",\\\"to\\\":\\\"2026-11-11T12:00:00Z\\\",\\\"limit\\\":100}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_E9cB9m80LCdQLeYqsZVZ5sYF\",\"output\":\"{\\n  \\\"messages\\\": [\\n    {\\n      \\\"message\\\": \\\"msg_c5ee0b577c2a4eff\\\",\\n      \\\"thread\\\": \\\"thr_63437fd9fda34c00\\\",\\n      \\\"from\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"to\\\": [\\n        {\\n          \\\"email\\\": \\\"me@example.test\\\",\\n          \\\"name\\\": \\\"Sam Example\\\"\\n        }\\n      ],\\n      \\\"subject\\\": \\\"Q3 budget numbers\\\",\\n      \\\"snippet\\\": \\\"Can you bring the latest budget sheet to tomorrow's review?\\\",\\n      \\\"sent_at\\\": \\\"2026-11-09T08:12:00Z\\\",\\n      \\\"unread\\\": true,\\n      \\\"labels\\\": [\\n        \\\"INBOX\\\",\\n        \\\"UNREAD\\\"\\n      ],\\n      \\\"body\\\": {\\n        \\\"text\\\": \\\"Hi Sam,\\\\n\\\\nCan you bring the latest budget sheet to tomorrow's planning review? Finance wants the Q3 travel line.\\\\n\\\\nThanks,\\\\nDana\\\",\\n        \\\"truncated\\\": false,\\n        \\\"limit_chars\\\": 20000\\n      },\\n      \\\"attachments\\\": []\\n    }\\n  ]\\n}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_2xHlz951kHP3LpBuDMb0ToEo\",\"output\":\"{\\n  \\\"file\\\": \\\"file_e07ee01f14a646aa\\\",\\n  \\\"name\\\": \\\"Q3 Budget\\\",\\n  \\\"mime_type\\\": \\\"application/vnd.google-apps.spreadsheet\\\",\\n  \\\"modified_at\\\": \\\"2026-11-08T17:00:00Z\\\",\\n  \\\"modified_by\\\": \\\"Dana Example\\\",\\n  \\\"native_type\\\": \\\"spreadsheet\\\",\\n  \\\"web_url\\\": \\\"https://docs.example.test/spreadsheets/d/f-budget\\\",\\n  \\\"text\\\": {\\n    \\\"text\\\": \\\"line,q2,q3\\\\ntravel,12000,15500\\\\nsoftware,8000,8200\\\\nevents,4000,6500\\\",\\n    \\\"truncated\\\": false,\\n    \\\"limit_chars\\\": 100000\\n  },\\n  \\\"exported_as\\\": \\\"text/csv\\\"\\n}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_0kB8CmX73aSmpsNxZe6xFYOi\",\"output\":\"{\\n  \\\"events\\\": [\\n    {\\n      \\\"event\\\": \\\"evt_b869a5dc328948d0\\\",\\n      \\\"title\\\": \\\"Team standup\\\",\\n      \\\"start\\\": \\\"2026-11-10T09:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-10T09:15:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"lee@example.test\\\",\\n        \\\"name\\\": \\\"Lee Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    },\\n    {\\n      \\\"event\\\": \\\"evt_7b96131c153d4742\\\",\\n      \\\"title\\\": \\\"Q3 planning review\\\",\\n      \\\"start\\\": \\\"2026-11-10T14:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-10T15:00:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"location\\\": \\\"Room 4\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    }\\n  ]\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be09-4e1a-74ee-a458-6512c5de3e08\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
          },
          "queryString": [],
          "url": "https://api.openai.com/v1/responses"
