\"function_call\",\"id\":\"fc_0c008018e11fdb7f016af12a2b456c87d0a8f565f207d7877b\",\"call_id\":\"call_7RcFRaF83wb51KDocWKIuVzI\",\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"tools list mail --schema\\\",\\\"timeout\\\":30}\"},{\"type\":\"function_call\",\"id\":\"fc_0c008018e11fdb7f016af12a2b457c87d0b61d91f8f474e36e\",\"call_id\":\"call_oPEdKjCht4BLTBsD5O7VqjXL\",\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"tools list calendar --schema\\\",\\\"timeout\\\":30}\"},{\"type\":\"function_call\",\"id\":\"fc_0c008018e11fdb7f016af12a2b458c87d09fe0d2e3722751c2\",\"call_id\":\"call_pZQbXJi8IpW7EsTpgXUvf8mS\",\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"tools list drive --schema\\\",\\\"timeout\\\":30}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_7RcFRaF83wb51KDocWKIuVzI\",\"output\":\"mail.search {\\\"query\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Words to search for\\\",\\\"minLength\\\":1,\\\"maxLength\\\":1000},\\\"folder\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A label name, such as inbox\\\",\\\"minLength\\\":1,\\\"maxLength\\\":200},\\\"from\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"Sender address or name\\\",\\\"minLength\\\":1,\\\"maxLength\\\":320},\\\"after\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"RFC 3339 time with offset\\\"},\\\"before\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"RFC 3339 time with offset\\\"},\\\"unread\\\":{\\\"type\\\":\\\"boolean\\\",\\\"description\\\":\\\"true for unread messages only, false for read ones only\\\"},\\\"limit\\\":{\\\"type\\\":\\\"integer\\\",\\\"description\\\":\\\"At most this many results\\\",\\\"minimum\\\":1,\\\"maximum\\\":100,\\\"default\\\":25},\\\"cursor\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A cursor from the previous page, with the same arguments\\\",\\\"minLength\\\":1}}\\nmail.read {\\\"message\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A message handle (msg_…)\\\",\