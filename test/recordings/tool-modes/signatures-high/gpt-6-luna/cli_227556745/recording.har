.<command>({...})`) makes several.\",\"name\":\"bash\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"required\":[\"command\",\"timeout\"],\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"Shell command to execute\"},\"timeout\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Timeout in seconds (optional, no default timeout)\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"strict\":true},{\"type\":\"function\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"name\":\"read\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"strict\":true}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":{\"input_tokens\":5605,\"input_tokens_details\":{\"cache_write_tokens\":1218,\"cached_tokens\":4384},\"output_tokens\":736,\"output_tokens_details\":{\"reasoning_tokens\":614},\"total_tokens\":6341},\"user\":null,\"metadata\":{}},\"sequence_number\":524}\n\n"
