all_9bAVtad65YmAjlMWwk2LDlhA\",\"output\":\"{\\n  \\\"events\\\": [\\n    {\\n      \\\"event\\\": \\\"evt_0b9bbc71d15745ad\\\",\\n      \\\"title\\\": \\\"Team standup\\\",\\n      \\\"start\\\": \\\"2026-11-10T09:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-10T09:15:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"lee@example.test\\\",\\n        \\\"name\\\": \\\"Lee Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    },\\n    {\\n      \\\"event\\\": \\\"evt_7abc9056620f4340\\\",\\n      \\\"title\\\": \\\"Q3 planning review\\\",\\n      \\\"start\\\": \\\"2026-11-10T14:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-10T15:00:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"location\\\": \\\"Room 4\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    }\\n  ]\\n}\\n\"},{\"type\":\"function_call_output\",\"call_id\":\"call_KqOQpzNSZhXvVlFk3JLloZyM\",\"output\":\"{\\n  \\\"file\\\": \\\"file_2c013891031a48a3\\\",\\n  \\\"name\\\": \\\"Q3 Budget\\\",\\n  \\\"mime_type\\\": \\\"application/vnd.google-apps.spreadsheet\\\",\\n  \\\"modified_at\\\": \\\"2026-11-08T17:00:00Z\\\",\\n  \\\"modified_by\\\": \\\"Dana Example\\\",\\n  \\\"native_type\\\": \\\"spreadsheet\\\",\\n  \\\"web_url\\\": \\\"https://docs.example.test/spreadsheets/d/f-budget\\\",\\n  \\\"text\\\": {\\n    \\\"text\\\": \\\"line,q2,q3\\\\ntravel,12000,15500\\\\nsoftware,8000,8200\\\\nevents,4000,6500\\\",\\n    \\\"truncated\\\": false,\\n    \\\"limit_chars\\\": 100000\\n  },\\n  \\\"exported_as\\\": \\\"text/csv\\\"\\n}\\n\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be0c-a70e-74ee-a458-65227b73e9e9\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"in