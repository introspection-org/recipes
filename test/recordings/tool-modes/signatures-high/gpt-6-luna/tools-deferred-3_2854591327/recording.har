\":{\"type\":\"string\",\"description\":\"The event's title\",\"minLength\":1,\"maxLength\":1000},\"start\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"end\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"time_zone\":{\"type\":\"string\",\"description\":\"IANA time zone, such as America/New_York\",\"minLength\":1},\"all_day\":{\"type\":\"boolean\",\"description\":\"An all-day event: start and end are dates (YYYY-MM-DD)\"},\"attendees\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":320},\"description\":\"Attendee addresses; on update, the full list\",\"maxItems\":100},\"location\":{\"type\":\"string\",\"description\":\"Where the event is\",\"maxLength\":1000},\"body\":{\"type\":\"string\",\"description\":\"The event's description, in Markdown\",\"maxLength\":100000},\"online_meeting\":{\"type\":\"boolean\",\"description\":\"Add an online meeting link\"}},\"required\":[\"command\",\"title\",\"start\",\"end\",\"time_zone\"],\"additionalProperties\":false,\"description\":\"Create an event. With attendees, invitations go out at once. Notifies other people.\"},{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"update\"},\"event\":{\"type\":\"string\",\"description\":\"An event handle (evt_…)\",\"minLength\":1},\"title\":{\"type\":\"string\",\"description\":\"The event's title\",\"minLength\":1,\"maxLength\":1000},\"start\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"end\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"time_zone\":{\"type\":\"string\",\"description\":\"IANA time zone, such as America/New_York\",\"minLength\":1},\"all_day\":{\"type\":\"boolean\",\"description\":\"An all-day event: start and end are dates (YYYY-MM-DD)\"},\"attendees\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"