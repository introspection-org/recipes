?, name? }: Upload a file from outputs/ as a new file. Returns its handle. Changes the person's data; can be undone.\",\"name\":\"drive\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\",\"enum\":[\"search\",\"read\",\"download\",\"upload\"]},\"query\":{\"type\":\"string\",\"description\":\"Words to search for\",\"minLength\":1,\"maxLength\":1000},\"folder\":{\"type\":\"string\",\"description\":\"A folder's file handle; without it, the whole drive, or its root for upload\",\"minLength\":1},\"modified_after\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"limit\":{\"type\":\"integer\",\"description\":\"At most this many results\",\"minimum\":1,\"maximum\":100,\"default\":25},\"cursor\":{\"type\":\"string\",\"description\":\"A cursor from the previous page, with the same arguments\",\"minLength\":1},\"file\":{\"type\":\"string\",\"description\":\"A file handle (file_…)\",\"minLength\":1},\"path\":{\"type\":\"string\",\"description\":\"A file under outputs/\",\"minLength\":1},\"name\":{\"type\":\"string\",\"description\":\"The new file's name; default the local file's name\",\"minLength\":1,\"maxLength\":255}},\"required\":[\"command\"],\"additionalProperties\":false,\"anyOf\":[{\"type\":\"object\",\"properties\":{\"command\":{\"const\":\"search\"},\"query\":{\"type\":\"string\",\"description\":\"Words to search for\",\"minLength\":1,\"maxLength\":1000},\"folder\":{\"type\":\"string\",\"description\":\"A folder's file handle; without it, the whole drive, or its root for upload\",\"minLength\":1},\"modified_after\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"limit\":{\"type\":\"integer\",\"description\":\"At most this many results\",\"minimum\":1,\"maximum\":100,\"default\":25},\"cursor\":{\"type\":\"string\",\"description\":\"A cursor from the previous page, with the same arguments\",\"minLength\":1}},\"required\":[\"command\",\"query\"],\"additionalProperties\":