: \\\"https://docs.example.test/spreadsheets/d/f-budget\\\"\\n    }\\n  ]\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be08-cfaa-74ee-a458-651075a2bd5b\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
