"function_call\",\"id\":\"fc_06dd2e904fb3a7cb016af12945d86887d09787c31480663726\",\"call_id\":\"call_a27OgvTFN6qdM4vWnaayDn5y\",\"name\":\"mail\",\"arguments\":\"{\\\"command\\\":\\\"draft\\\",\\\"to\\\":[\\\"dana@example.test\\\"],\\\"subject\\\":\\\"Re: Q3 budget numbers\\\",\\\"body\\\":\\\"Hi Dana,\\\\n\\\\nI’ll bring the latest Q3 budget sheet to tomorrow’s planning review. Here’s the sheet: https://docs.example.test/spreadsheets/d/f-budget\\\\n\\\\nBest,\\\\nSam\\\",\\\"reply_to\\\":\\\"msg_cc76d39e3a674542\\\"}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_a27OgvTFN6qdM4vWnaayDn5y\",\"output\":\"{\\n  \\\"draft\\\": \\\"msg_5abecda397cd406d\\\",\\n  \\\"thread\\\": \\\"thr_5078c4fcfd7444e0\\\",\\n  \\\"to\\\": [\\n    {\\n      \\\"email\\\": \\\"dana@example.test\\\"\\n    }\\n  ],\\n  \\\"subject\\\": \\\"Re: Q3 budget numbers\\\"\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be08-cfaa-74ee-a458-651075a2bd5b\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
