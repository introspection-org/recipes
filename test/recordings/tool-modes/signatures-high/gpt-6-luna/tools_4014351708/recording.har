ple.\\ncancel { event, comment? }: Cancel an event the person organizes; attendees are told. Cannot be undone. Google sends attendees its own cancellation notice; a comment is not delivered.\",\"name\":\"calendar\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\",\"enum\":[\"list\",\"read\",\"free_busy\",\"create\",\"update\",\"respond\",\"cancel\"]},\"from\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"to\":{\"type\":\"string\",\"description\":\"RFC 3339 time with offset\"},\"calendar\":{\"type\":\"string\",\"description\":\"A calendar name; default the primary calendar\",\"minLength\":1,\"maxLength\":200},\"limit\":{\"type\":\"integer\",\"description\":\"At most this many results\",\"minimum\":1,\"maximum\":100,\"default\":25},\"cursor\":{\"type\":\"string\",\"description\":\"A cursor from the previous page, with the same arguments\",\"minLength\":1},\"event\":{\"type\":\"string\",\"description\":\"An event handle (evt_…)\",\"minLength\":1},\"attendees\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":320},\"description\":\"The addresses whose busy times to read\",\"minItems\":1,\"maxItems\":50},{\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":320},\"description\":\"Attendee addresses; on update, the full list\",\"maxItems\":100}]},\"time_zone\":{\"type\":\"string\",\"description\":\"IANA time zone, such as America/New_York\",\"minLength\":1},\"title\":{\"type\":\"string\",\"description\":\"The event's title\",\"minLength\":1,\"maxLength\":1000},\"start\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"end\":{\"type\":\"string\",\"description\":\"RFC 3339 date-time, read in time_zone; a date when all_day\"},\"all_day\":{\"type\":\"boolean\",\"description\":\"An all-day event: start and end are dates (YYYY-MM-DD)\"},\"location\":{\"type\":\"string\",\"d