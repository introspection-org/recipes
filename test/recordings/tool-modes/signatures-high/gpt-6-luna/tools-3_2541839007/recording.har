b7e016af1297639a487d08ac4ecf276310c7e\",\"call_id\":\"call_Hiu9NXgcn8pED1D43VhoZmx9\",\"name\":\"mail\",\"arguments\":\"{\\\"command\\\":\\\"draft\\\",\\\"to\\\":[\\\"dana@example.test\\\"],\\\"subject\\\":\\\"Re: Q3 budget numbers\\\",\\\"body\\\":\\\"Hi Dana,\\\\n\\\\nI’ll bring the latest budget sheet to tomorrow’s planning review. Here’s the sheet: [Q3 Budget](https://docs.example.test/spreadsheets/d/f-budget).\\\\n\\\\nSee you then,\\\\nSam\\\",\\\"reply_to\\\":\\\"msg_0aa3c92ae38741be\\\"}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_Hiu9NXgcn8pED1D43VhoZmx9\",\"output\":\"{\\n  \\\"draft\\\": \\\"msg_1e6b42129cf54331\\\",\\n  \\\"thread\\\": \\\"thr_89e746fddee04655\\\",\\n  \\\"to\\\": [\\n    {\\n      \\\"email\\\": \\\"dana@example.test\\\"\\n    }\\n  ],\\n  \\\"subject\\\": \\\"Re: Q3 budget numbers\\\"\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be09-b025-74ee-a458-65153a06344c\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
