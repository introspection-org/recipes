      \\\"from\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"to\\\": [\\n        {\\n          \\\"email\\\": \\\"me@example.test\\\",\\n          \\\"name\\\": \\\"Sam Example\\\"\\n        }\\n      ],\\n      \\\"subject\\\": \\\"Q3 budget numbers\\\",\\n      \\\"snippet\\\": \\\"Can you bring the latest budget sheet to tomorrow's review?\\\",\\n      \\\"sent_at\\\": \\\"2026-11-09T08:12:00Z\\\",\\n      \\\"unread\\\": true,\\n      \\\"labels\\\": [\\n        \\\"INBOX\\\",\\n        \\\"UNREAD\\\"\\n      ],\\n      \\\"body\\\": {\\n        \\\"text\\\": \\\"Hi Sam,\\\\n\\\\nCan you bring the latest budget sheet to tomorrow's planning review? Finance wants the Q3 travel line.\\\\n\\\\nThanks,\\\\nDana\\\",\\n        \\\"truncated\\\": false,\\n        \\\"limit_chars\\\": 20000\\n      },\\n      \\\"attachments\\\": []\\n    }\\n  ]\\n}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_gDjKcOo28EqLfo8OeBxXcKhh\",\"output\":\"{\\n  \\\"events\\\": [\\n    {\\n      \\\"event\\\": \\\"evt_0d76b2b61d9d4318\\\",\\n      \\\"title\\\": \\\"Team standup\\\",\\n      \\\"start\\\": \\\"2026-11-10T09:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-10T09:15:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"lee@example.test\\\",\\n        \\\"name\\\": \\\"Lee Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    },\\n    {\\n      \\\"event\\\": \\\"evt_a37ccdaed94045b1\\\",\\n      \\\"title\\\": \\\"Q3 planning review\\\",\\n      \\\"start\\\": \\\"2026-11-10T14:00:00Z\\\",\\n      \\\"end\\\": \\\"2026-11-10T15:00:00Z\\\",\\n      \\\"time_zone\\\": \\\"UTC\\\",\\n      \\\"location\\\": \\\"Room 4\\\",\\n      \\\"organizer\\\": {\\n        \\\"email\\\": \\\"dana@example.test\\\",\\n        \\\"name\\\": \\\"Dana Example\\\"\\n      },\\n      \\\"response\\\": \\\"accepted\\\"\\n    }\\n  ]\\n}\"},{\"type\":\"function_call_output\",\"call_id\":\"call_oXjF7UnAIXnnXgz4ZMnscJ9H\",\"output\":\"{\\n  \\\"file\\\": \\\"file_bec946ea94634965\\\",\\n  \\\"name\\\": \\\"Q3 Budget\\\",\\n  \\\"mime_type\\\": \\\"application/vnd.google-apps.spreadsheet\\\",\\n  \\\"modified_at\\\": \\\"2026-11-08T17:00:00Z\\\",\\n  \\\"modified_by\\\": \\\"Dana Example\\\",\\n  \\\"native_type\\\": \\\"spreadsheet\\\",\\n  \\\"web_url\\\": \\\"https://docs.example.test/spreadsheets/d/f-budget\\\",\\n  \\\"text\\\": {\\n    \\\"text\\\": \\\"line,q2,q3\\\\ntravel,12000,15500\\\\nsoftware,8000,8200\\\\nevents,4000,6500\\\",\\n    \\\"truncated\\\": false,\\n    \\\"limit_chars\\\": 100000\\n  },\\n  \\\"exported_as\\\": \\\"text/csv\\\"\\n}\"},{\"type\":\"configuration_update\",\"reasoning\":{\"effort\":\"high\"}}],\"stream\":true,\"prompt_cache_key\":\"01a1be09-b025-74ee-a458-65153a06344c\",\"store\":false,\"max_output_tokens\":128000,\"reasoning\":{\"effort\":\"medium\",\"summary\":\"auto\"},\"include\":[\"reasoning.encrypted_content\"]}"
