h\\\":1,\\\"maxLength\\\":1000},\\\"folder\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A folder's file handle; without it, the whole drive, or its root for upload\\\",\\\"minLength\\\":1},\\\"modified_after\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"RFC 3339 time with offset\\\"},\\\"limit\\\":{\\\"type\\\":\\\"integer\\\",\\\"description\\\":\\\"At most this many results\\\",\\\"minimum\\\":1,\\\"maximum\\\":100,\\\"default\\\":25},\\\"cursor\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A cursor from the previous page, with the same arguments\\\",\\\"minLength\\\":1}}\\ndrive.read {\\\"file\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A file handle (file_…)\\\",\\\"minLength\\\":1}}\\ndrive.download {\\\"file\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A file handle (file_…)\\\",\\\"minLength\\\":1}}\\ndrive.upload {\\\"path\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A file under outputs/\\\",\\\"minLength\\\":1},\\\"folder\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"A folder's file handle; without it, the whole drive, or its root for upload\\\",\\\"minLength\\\":1},\\\"name\\\":{\\\"type\\\":\\\"string\\\",\\\"description\\\":\\\"The new file's name; default the local file's name\\\",\\\"minLength\\\":1,\\\"maxLength\\\":255}}\\n\",\"is_error\":false,\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"high\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a conformance fixture.\\n\\nConformance agent\\n\\n<skills>\\nThe following skills provide specialized instructions for specific tasks.\\nUse the read tool to load a skill's file when the task matches its description.\\nResolve relative paths against the skill's directory (parent of SKILL.md). Use absolute paths in tool calls.\\n\\n<available_skills>\\n  <skill>\\n    <name>productivity</name>\\n    <description>How to use the mail, calendar and drive tools well. Load it before searching, reading, drafting or sending mail, scheduling or answering meetings, or finding, reading or uploading files.</description>\\n    <location>/repo/skills/productivity/SKILL.md</location>\\n  </skill>\\n</available_skills>\\n</skills>\\n\\n<cwd>\\n/tmp/recipe-conformance-qPdTfJ/workspace\\n</cwd>\",\"cache_control\":{\"type\":\"ephemeral\"}}],\"tools\":[{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\\n\\nmail, calendar, drive are not tools you call directly: reach them from bash with the `tools` command. `tools list` shows them, `tools list <tool> --schema` a tool's commands and arguments, `tools call <tool>.<command> --json -` with the arguments on stdin in a quoted heredoc (`<<'JSON'`), so quotes in them need no escaping, makes one call, and `tools run` with a script on stdin (`await tools.<tool>.<command>({...})`) makes several.\",\"eager_input_streaming\":true,\"strict\":true,\"input_schema\":{\"type\":\"object\",\"required\":[\"command\",\"timeout\"],\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"Shell command to execute\"},\"timeout\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Timeout in seconds (optional, no default timeout)\"},{\"type\":\"null\"}]}},\"additionalProperties\":false}},{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"eager_input_streaming\":true,\"strict\":true,\"input_schema\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"cache_control\":{\"type\":\"ephemeral\"}},{\"name\":\"__pi_deferred_placeholder__\",\"description\":\"Reserved placeholder. Never available. Never call this.\",\"input_schema\":{\"type\":\"object\",\"properties\":{},\"required\":[]},\"defer_loading\":true}],\"thinking\":{\"type\":\"adaptive\",\"display\":\"summarized\",\"block_binding\":{\"prefix_mismatch_behavior\":\"drop_block\"}},\"output_config\":{\"effort\":\"low\"}}"
