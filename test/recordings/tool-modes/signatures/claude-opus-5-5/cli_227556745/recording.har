sage\\\\\\\": \\\\\\\"msg_c6c4f76fe1b14e25\\\\\\\",\\\\n      \\\\\\\"thread\\\\\\\": \\\\\\\"thr_ed4c5e546ef54c31\\\\\\\",\\\\n      \\\\\\\"from\\\\\\\": {\\\\n        \\\\\\\"email\\\\\\\": \\\\\\\"dana@example.test\\\\\\\",\\\\n        \\\\\\\"name\\\\\\\": \\\\\\\"Dana Example\\\\\\\"\\\\n      },\\\\n      \\\\\\\"to\\\\\\\": [\\\\n        {\\\\n          \\\\\\\"email\\\\\\\": \\\\\\\"me@example.test\\\\\\\",\\\\n          \\\\\\\"name\\\\\\\": \\\\\\\"Sam Example\\\\\\\"\\\\n        }\\\\n      ],\\\\n      \\\\\\\"subject\\\\\\\": \\\\\\\"Q3 budget numbers\\\\\\\",\\\\n      \\\\\\\"snippet\\\\\\\": \\\\\\\"Can you bring the latest budget sheet to tomorrow's review?\\\\\\\",\\\\n      \\\\\\\"sent_at\\\\\\\": \\\\\\\"2026-11-09T08:12:00Z\\\\\\\",\\\\n      \\\\\\\"unread\\\\\\\": true,\\\\n      \\\\\\\"labels\\\\\\\": [\\\\n        \\\\\\\"INBOX\\\\\\\",\\\\n        \\\\\\\"UNREAD\\\\\\\"\\\\n      ]\\\\n    }\\\\n  ]\\\\n}\\\"\\n\\\"{\\\\n  \\\\\\\"files\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"file\\\\\\\": \\\\\\\"file_f0aa3430f9794f8b\\\\\\\",\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"Q3 Budget\\\\\\\",\\\\n      \\\\\\\"mime_type\\\\\\\": \\\\\\\"application/vnd.google-apps.spreadsheet\\\\\\\",\\\\n      \\\\\\\"modified_at\\\\\\\": \\\\\\\"2026-11-08T17:00:00Z\\\\\\\",\\\\n      \\\\\\\"modified_by\\\\\\\": \\\\\\\"Dana Example\\\\\\\",\\\\n      \\\\\\\"native_type\\\\\\\": \\\\\\\"spreadsheet\\\\\\\",\\\\n      \\\\\\\"web_url\\\\\\\": \\\\\\\"https://docs.example.test/spreadsheets/d/f-budget\\\\\\\"\\\\n    }\\\\n  ]\\\\n}\\\"\\nnull\\n\",\"is_error\":false,\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"system\",\"content\":[],\"output_config\":{\"effort\":\"low\"}}],\"max_tokens\":128000,\"stream\":true,\"system\":[{\"type\":\"text\",\"text\":\"You are a conformance fixture.\\n\\nConformance agent\\n\\n<skills>\\nThe following skills provide specialized instructions for specific tasks.\\nUse the read tool to load a skill's file when the task matches its description.\\nResolve relative paths against the skill's directory (parent of SKILL.md). Use absolute paths in tool calls.\\n\\n<available_skills>\\n  <skill>\\n    <name>productivity</name>\\n    <description>How to use the mail, calendar and drive tools well. Load it before searching, reading, drafting or sending mail, scheduling or answering meetings, or finding, reading or uploading files.</description>\\n    <location>/repo/skills/productivity/SKILL.md</location>\\n  </skill>\\n</available_skills>\\n</skills>\\n\\n<cwd>\\n/tmp/recipe-conformance-Ufxg0I/workspace\\n</cwd>\",\"cache_control\":{\"type\":\"ephemeral\"}}],\"tools\":[{\"name\":\"bash\",\"description\":\"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\\n\\nmail, calendar, drive are not tools you call directly: reach them from bash with the `tools` command. `tools list` shows them, `tools list <tool> --schema` a tool's commands and arguments, `tools call <tool>.<command> --json -` with the arguments on stdin in a quoted heredoc (`<<'JSON'`), so quotes in them need no escaping, makes one call, and `tools run` with a script on stdin (`await tools.<tool>.<command>({...})`) makes several.\",\"eager_input_streaming\":true,\"strict\":true,\"input_schema\":{\"type\":\"object\",\"required\":[\"command\",\"timeout\"],\"properties\":{\"command\":{\"type\":\"string\",\"description\":\"Shell command to execute\"},\"timeout\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Timeout in seconds (optional, no default timeout)\"},{\"type\":\"null\"}]}},\"additionalProperties\":false}},{\"name\":\"read\",\"description\":\"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"eager_input_streaming\":true,\"strict\":true,\"input_schema\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"cache_control\":{\"type\":\"ephemeral\"}},{\"name\":\"__pi_deferred_placeholder__\",\"description\":\"Reserved placeholder. Never available. Never call this.\",\"input_schema\":{\"type\":\"object\",\"properties\":{},\"required\":[]},\"defer_loading\":true}],\"thinking\":{\"type\":\"adaptive\",\"display\":\"summarized\",\"block_binding\":{\"prefix_mismatch_behavior\":\"drop_block\"}},\"output_config\":{\"effort\":\"low\"}}"
