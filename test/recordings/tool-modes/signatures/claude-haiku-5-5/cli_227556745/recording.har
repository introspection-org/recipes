{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":4,\"cache_creation_input_tokens\":1485,\"cache_read_input_tokens\":0,\"output_tokens\":181,\"output_tokens_details\":{\"thinking_tokens\":51}}      }\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"      }\n\n"
