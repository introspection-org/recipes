p). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"name\":\"read\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"strict\":true}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":null,\"user\":null,\"metadata\":{}},\"sequence_number\":1}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"fc_080afb92f8849c82016af13b2f840887d0a8c95a98ea5b4311\",\"type\":\"function_call\",\"status\":\"in_progress\",\"arguments\":\"\",\"call_id\":\"call_9TkZaAjJPrcFHV3lucyaxqZL\",\"name\":\"bash\"},\"output_index\":0,\"sequence_number\":2}\n\nevent: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\\\"command\\\":\\\"tools call mail.search --json - <<'JSON'\\\\n{\\\\\\\"query\\\\\\\":\\\\\\\"budget\\\\\\\",\\\\\\\"from\\\\\\\":\\\\\\\"Dana\\\\\\\"}\\\\nJSON\\\\ntools call drive.search --json - <<'JSON'\\\\n{\\\\\\\"query\\\\\\\":\\\\\\\"budget\\\\\\\"}\\\\nJSON\\\\ndate -Iseconds\\\",\\\"timeout\\\":null}\",\"item_id\":\"fc_080afb92f8849c82016af13b2f840887d0a8c95a98ea5b4311\",\"obfuscation\":\"2mg0sihuGJp8Pt\",\"output_index\":0,\"sequence_number\":3}\n\nevent: response.function_call_arguments.done\ndata: {\"type\":\"response.function_call_arguments.done\",\"arguments\":\"{\\\"command\\\":\\\"tools call mail.search --json - <<'JSON