p). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.\",\"name\":\"read\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"required\":[\"path\",\"offset\",\"limit\"],\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to the file to read (relative or absolute)\"},\"offset\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Line number to start reading from (1-indexed)\"},{\"type\":\"null\"}]},\"limit\":{\"anyOf\":[{\"type\":\"number\",\"description\":\"Maximum number of lines to read\"},{\"type\":\"null\"}]}},\"additionalProperties\":false},\"strict\":true}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":null,\"user\":null,\"metadata\":{}},\"sequence_number\":1}\n\nevent: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"item\":{\"id\":\"fc_080afb92f8849c82016af13b3884cc87d0ac835344ad98f016\",\"type\":\"function_call\",\"status\":\"in_progress\",\"arguments\":\"\",\"call_id\":\"call_hfiXHab4Fu4FZltwL7kPKkcM\",\"name\":\"bash\"},\"output_index\":0,\"sequence_number\":2}\n\nevent: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"delta\":\"{\\\"command\\\":\\\"tools call mail.draft --json - <<'JSON'\\\\n{\\\\\\\"to\\\\\\\":[\\\\\\\"dana@example.test\\\\\\\"],\\\\\\\"subject\\\\\\\":\\\\\\\"Re: Q3 budget numbers\\\\\\\",\\\\\\\"reply_to\\\\\\\":\\\\\\\"msg_c6a7e78301b64b53\\\\\\\",\\\\\\\"body\\\\\\\":\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI'll bring the [Q3 Budget spreadsheet](https://docs.example.test/spreadsheets/d/f-budget) to the planning review.\\\\\\\\n\\\\\\\\nThanks,\\\\\\\\nSam\\\\\\\"}\\\\nJSON\\\",\\\"timeout\\\":null}\",\"item_id\":\"fc_080afb92f8849c82016af13b3884cc87d0ac835344ad98f016\",\"obfuscation\":\"WXTmzoXalJPb1g\",\"output_index\":0,\"sequence_number\":3}\n\nevent: response.function_call_arguments.done\ndata: {\"type\":\"response.function_call_arguments.done\",\"arguments\":\"{\\\"command\\\":\\\"tools call mail.draft --json - <<'JSON'\\\\n{\\\\\\\"to\\\\\\\":[\\\\\\\"dana@example.test\\\\\\\"],\\\\\\\"subject\\\\\\\":\\\\\\\"Re: Q3 budget numbers\\\\\\\",\\\\\\\"reply_to\\\\\\\":\\\\\\\"msg_c6a7e78301b64b53\\\\\\\",\\\\\\\"body\\\\\\\":\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI'll bring the [Q3 Budget spreadsheet](https://docs.example.test/spreadsheets/d/f-budget) to the planning review.\\\\\\\\n\\\\\\\\nThanks,\\\\\\\\nSam\\\\\\\"}\\\\nJSON\\\",\\\"timeout\\\":null}\",\"item_id\":\"fc_080afb92f8849c82016af13b3884cc87d0ac835344ad98f016\",\"output_index\":0,\"sequence_number\":109}\n\nevent: response.output_item.done\ndata: {\"type\":\"response.output_item.done\",\"item\":{\"id\":\"fc_080afb92f8849c82016af13b3884cc87d0ac835344ad98f016\",\"type\":\"function_call\",\"status\":\"completed\",\"arguments\":\"{\\\"command\\\":\\\"tools call mail.draft --json - <<'JSON'\\\\n{\\\\\\\"to\\\\\\\":[\\\\\\\"dana@example.test\\\\\\\"],\\\\\\\"subject\\\\\\\":\\\\\\\"Re: Q3 budget numbers\\\\\\\",\\\\\\\"reply_to\\\\\\\":\\\\\\\"msg_c6a7e78301b64b53\\\\\\\",\\\\\\\"body\\\\\\\":\\\\\\\"Hi Dana,\\\\\\\\n\\\\\\\\nI'll bring the [Q3 Budget spreadsheet](https://docs.example.test/spreadsheets/d/f-budget) to the planning review.\\\\\\\\n\\\\\\\\nThanks,\\\\\\\\nSam\\\\\\\"}\\\\nJSON\\\",\\\"timeout\\\":null}\",\"call_id\":\"call_hfiXHab4Fu4FZltwL7kPKkcM\",\"name\":\"bash\"},\"output_index\":0,\"sequence_number\":110}\n\nevent: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_080afb92f8849c82016af13b377f6087d0921f3104e6b17995\",\"object\":\"response\",\"created_at\":1794194231,\"status\":\"completed\",\"access_programs\":null,\"background\":false,\"completed_at\":1794194233,\"error\":null,\"frequency_penalty\":0.0,\"image\":{\"context_compression\":\"disabled\"},\"incomplete_details\":null,\"instructions\":nul