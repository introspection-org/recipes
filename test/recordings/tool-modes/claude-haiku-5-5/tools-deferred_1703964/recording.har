  }\n\nevent: content_block_start\ndata: {\"type\":\"content_block_start\",\"index\":2,\"content_block\":{\"type\":\"tool_use\",\"id\":\"toolu_018eweoim1KzT6Lcdts5AWk3\",\"name\":\"drive\",\"input\":{},\"caller\":{\"type\":\"direct\"}}              }\n\nevent: content_block_delta\ndata: {\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"command\\\": \\\"search\\\", \\\"query\\\": \\\"budget\\\", \\\"limit\\\": 10}\"}}\n\nevent: content_block_stop\ndata: {\"type\":\"content_block_stop\",\"index\":2             }\n\nevent: message_delta\ndata: {\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":4692,\"cache_read_input_tokens\":2677,\"output_tokens\":275,\"output_tokens_details\":{\"thinking_tokens\":74}}  }\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"            }\n\n"
