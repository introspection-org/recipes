e\":null,\"stop_details\":null,\"container\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":518,\"cache_read_input_tokens\":8597,\"output_tokens\":272,\"output_tokens_details\":{\"thinking_tokens\":32}}            }\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"}\n\n"
