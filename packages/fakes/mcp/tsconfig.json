{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@introspection-ai/recipe-fakes-mcp": ["./src/index.ts"],
      "@introspection-ai/recipe-fakes-mcp/checks": ["./src/checks.ts"],
      "@introspection-ai/recipe-fakes-mcp/verify": ["./src/verify.ts"],
      "@introspection-ai/recipe-fakes-mcp/answers": ["./src/answers.ts"],
      "@introspection-ai/recipe-fakes-mcp/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
