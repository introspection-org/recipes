{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@introspection-ai/mcp-fakes": ["./src/index.ts"],
      "@introspection-ai/mcp-fakes/checks": ["./src/checks.ts"],
      "@introspection-ai/mcp-fakes/verify": ["./src/verify.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
