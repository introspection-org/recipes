{
  "name": "@introspection-ai/recipe-documents-pdf",
  "version": "0.1.0",
  "description": "PDF format for the Introspection Recipes documents tool: read and render pages.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "python/*.py",
    "python/pyproject.toml",
    "python/uv.lock",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/introspection-org/recipes.git",
    "directory": "packages/documents/pdf"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "pi": {
    "runtime": {
      "python": {
        "project": "python",
        "lockfile": "python/uv.lock",
        "version": ">=3.12,<3.15",
        "imports": ["pypdfium2", "PIL"]
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pack:check": "pnpm pack --dry-run --json | node ../../../scripts/check-npm-pack.mjs"
  },
  "dependencies": {
    "@introspection-ai/recipes": "workspace:>=0.39.0"
  },
  "peerDependencies": {
    "@introspection-ai/recipes": "workspace:>=0.39.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
